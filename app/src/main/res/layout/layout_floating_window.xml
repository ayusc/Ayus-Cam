<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Floating App Icon (Collapsed State) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_icon_container"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:cardCornerRadius="27dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_black">
        
        <ImageView
            android:id="@+id/floating_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/app_icon"
            android:scaleType="centerCrop"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Expanded Control Panel (Smaller Scale) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_panel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/bg_black"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <RelativeLayout
                android:id="@+id/panel_header"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@color/accent_red_dark"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AYUSCAM Control Panel"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_minimize"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btn_close"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adjustments"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <!-- Zoom -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:background="@color/inner_box_dark"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_zoom"
                        app:tint="@color/text_main" />
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text=" Zoom"
                        android:textColor="@color/text_main"
                        android:textSize="10sp" />
                    <SeekBar
                        android:id="@+id/seek_zoom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="200"
                        android:progressTint="@color/text_main"
                        android:thumbTint="@color/text_main" />
                    <TextView
                        android:id="@+id/tv_zoom_val"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="100%"
                        android:textColor="@color/text_main"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Rotate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:background="@color/inner_box_dark"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:tint="@color/text_main" />
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text=" Rotate"
                        android:textColor="@color/text_main"
                        android:textSize="10sp" />
                    <SeekBar
                        android:id="@+id/seek_rotate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="270"
                        android:progressTint="@color/text_main"
                        android:thumbTint="@color/text_main" />
                    <TextView
                        android:id="@+id/tv_rotate_val"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0°"
                        android:textColor="@color/text_main"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Volume -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:background="@color/inner_box_dark"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="@color/text_main" />
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text=" Volume"
                        android:textColor="@color/text_main"
                        android:textSize="10sp" />
                    <SeekBar
                        android:id="@+id/seek_volume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progressTint="@color/text_main"
                        android:thumbTint="@color/text_main" />
                    <TextView
                        android:id="@+id/tv_volume_val"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0%"
                        android:textColor="@color/text_main"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Aspect Ratio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aspect Ratio"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scale_fill"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Fill"
                        android:textSize="10sp"
                        android:textColor="@color/text_main"
                        app:backgroundTint="@color/inner_box_dark"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scale_stretch"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Stretch"
                        android:textSize="10sp"
                        android:textColor="@color/text_main"
                        app:backgroundTint="@color/inner_box_dark"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scale_fit"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Fit"
                        android:textSize="10sp"
                        android:textColor="@color/text_main"
                        app:backgroundTint="@color/inner_box_dark"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- D-Pad (Smaller) -->
                <RelativeLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal">

                    <!-- Top -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_pan_up"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        app:cardBackgroundColor="@color/inner_box_dark"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:src="@android:drawable/arrow_up_float" app:tint="@color/text_main" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bottom -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_pan_down"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        app:cardBackgroundColor="@color/inner_box_dark"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:src="@android:drawable/arrow_down_float" app:tint="@color/text_main" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Left -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_pan_left"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        app:cardBackgroundColor="@color/inner_box_dark"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:rotation="-90" android:src="@android:drawable/arrow_up_float" app:tint="@color/text_main" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Right -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_pan_right"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardBackgroundColor="@color/inner_box_dark"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:rotation="90" android:src="@android:drawable/arrow_up_float" app:tint="@color/text_main" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Center Play/Pause -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_play_pause"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        app:cardBackgroundColor="@color/inner_box_dark"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">
                        <ImageView
                            android:id="@+id/icon_play_pause"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="@color/text_main" />
                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
